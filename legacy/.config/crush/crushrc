option metrics false

provider add crush --disable true
provider add exa --disable true

provider add local-ollama \
  --type openai-compat \
  --base-url "http://ollama.home.arpa:11434/v1" \
  --api-key "ollama"

# Bump timeout for longer prefill times (30k+ tokens).
option request-timeout 0

provider add mercury-halogen \
  --type openai \
  --base-url "http://127.0.0.1:8731/v1" \
  --api-key "halogen"

model add local-ollama/gemma-large-1gpu \
  --name "gemma-large-1gpu" \
  --context-window 48000 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

model add local-ollama/qwen-small-1gpu \
  --name "qwen-small-1gpu" \
  --context-window 128000 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

# Must stay at or below the num_ctx the model is created with on nas
# (hosts/nas/services/ollama.nix). Qwen 3.8 27b has a dense KV cache and only
# fits the R9700 up to ~192k; past that ollama leaves gigabytes of weights in
# host RAM and decode falls off a cliff, so the context window is capped at
# 128k with room left for the 8k of output below.
model add local-ollama/qwen-large-1gpu \
  --name "qwen-large-1gpu" \
  --context-window 122880 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

# Cost of 1h = 0.33 SFr * 0.15 kW = ~0.05 SFr
#   input  1500 t/s, 5.4M t/h: 0.0092 SFr/Mtok
#   output 45 t/s,   162k t/h: 0.3    SFr/Mtok
# HALOGEN_VISION_TOWER unset, no image support.
# Model supports 262,144 context, we keep limit lower to leave room for
# compaction output.
model add mercury-halogen/qwen3.8-flash-next \
  --name "qwen-large-mercury-halogen" \
  --context-window 240000 \
  --default-max-tokens 65536 \
  --can-reason true \
  --reasoning-effort medium \
  --price-input 0.01 \
  --price-output 0.3 \
  --supports-images false

# The GPU was never broken, the context window above was too large.
model small local-ollama/qwen-large-1gpu --think
model large mercury-halogen/qwen3.8-flash-next --think

mcp add nix \
  --disabled false \
  --type stdio \
  --timeout 90 \
  --command "nix" \
  --args "run" \
  --args "github:utensils/mcp-nixos" \
  --args "--"

# Disabled in favor of Tavily.
# The mcp<2 pin is needed: mcp-searxng is not compatible with the 2.x SDK.
# The "bash -c" wrapper works around a bug in crush that duplicates all args,
# breaking the command line.
mcp add searxng \
  --disabled true \
  --type stdio \
  --command "bash" \
  --args "-c" \
  --args 'uvx -q --from mcp-searxng --with "mcp<2" mcp-searxng' \
  --env SEARXNG_URL "http://searxng.home.arpa" \
  --env UV_PYTHON_DOWNLOADS "never" \
  --env UV_PYTHON_PREFERENCE "system"

# Tavily web search. Uses TAVILY_API_KEY.
# Tavily's hosted MCP endpoint (streamable HTTP), so no npx/uvx spawn and no
# extra process to keep warm. Prompt-cost trim: the server offers five tools;
# tavily_crawl, tavily_map and tavily_research are bulk-crawl/research agents
# that cost credits and prompt tokens we rarely use from here, so only search
# and extract are registered. Drop the --enabled-tools lines for the full set.
if [[ -n "${TAVILY_API_KEY:-}" ]]; then
  mcp add tavily \
    --disabled false \
    --type http \
    --url "https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}" \
    --timeout 60 \
    --enabled-tools tavily_search \
    --enabled-tools tavily_extract
fi

# TODO: in YOLO mode we shouldn't need these, right?
permissions allow mcp_nix_nix
permissions allow mcp_tavily_tavily_search mcp_tavily_tavily_extract

# A Signal session is a chat, not a coding workspace. `question` renders a
# terminal form the phone can never see, so it is pure dead weight (~1.6k
# prompt tokens on every request).
permissions deny question

# Optional further trims, ~1k prompt tokens each line. Uncomment as needed.
# Scheduling, dispatched coding subagents, and language-server tools are
# rarely used from a chat session.
# permissions deny CronCreate CronDelete CronList
# permissions deny dispatch_agent apply_dispatch dismiss_dispatch cancel_dispatch message_agent
# permissions deny lsp_call_hierarchy lsp_definition lsp_diagnostics lsp_references lsp_rename lsp_replace_symbol lsp_restart lsp_symbols

# Crush ships nil_ls, nixd and statix as built-in nix LSPs and starts every one
# whose binary is on PATH, which means duplicate diagnostics. Only nixd is
# wanted, so the other two are switched off by their built-in names. Note the
# key must be the built-in name: an entry named "nix" does not resolve to nixd,
# it registers a third server with no filetypes and no root markers.
lsp add nil_ls --disabled true
lsp add statix --disabled true

# The SDD plugin has no command layer here, so its skills are reached by
# description ("create an ADR for ..."), never by typing /sdd:adr. Pointing at
# skills/ is what makes them loadable at all.
#
# The paths come from home-manager (programs.crush.skillPlugins), so the plugin
# is a pinned flake input living in the Nix store: a rebuild moves it, and
# nothing has to survive in a scratch checkout. Sourcing is conditional because
# the file only exists once that option is set somewhere.
if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/crush-skill-plugins.sh" ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/crush-skill-plugins.sh"
fi

