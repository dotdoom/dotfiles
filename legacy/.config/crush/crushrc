option metrics false

provider add crush --disable true
provider add exa --disable true

provider add local-ollama \
  --type openai-compat \
  --base-url "http://ollama.home.arpa:11434/v1" \
  --api-key "ollama"

# Bump timeout for longer prefill times (30k+ tokens).
option request-timeout 0

provider add mercury-halogen \
  --type openai \
  --base-url "http://mercury:8731/v1" \
  --api-key "halogen"

model add local-ollama/gemma-large-1gpu \
  --name "gemma-large-1gpu" \
  --context-window 48000 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

model add local-ollama/qwen-small-1gpu \
  --name "qwen-small-1gpu" \
  --context-window 128000 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

model add local-ollama/qwen-large-1gpu \
  --name "qwen-large-1gpu" \
  --context-window 128000 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

# Cost of 1h = 0.33 SFr * 0.15 kW = ~0.05 SFr
#   input  1500 t/s, 5.4M t/h: 0.0092 SFr/Mtok
#   output 45 t/s,   162k t/h: 0.3    SFr/Mtok
# HALOGEN_VISION_TOWER unset, no image support.
# Model supports 262,144 context, we keep limit lower to leave room for
# compaction output.
model add mercury-halogen/qwen3.8-flash-next \
  --name "qwen-large-mercury-halogen" \
  --context-window 240000 \
  --default-max-tokens 65536 \
  --can-reason true \
  --reasoning-effort medium \
  --price-input 0.01 \
  --price-output 0.3 \
  --supports-images false

model small local-ollama/qwen-small-1gpu
#model large local-ollama/qwen-large-1gpu --think
model large mercury-halogen/qwen3.8-flash-next --think

mcp add nix \
  --disabled false \
  --type stdio \
  --command "nix" \
  --args "run" \
  --args "github:utensils/mcp-nixos" \
  --args "--"

# Uses GITEA_HOST, GITEA_ACCESS_TOKEN
# Server-side trim: -r drops the 23 write tools, -O keeps a repo-work subset.
# All 57 tools cost ~9.5k prompt tokens, this subset costs ~2.1k.
mcp add gitea \
  --disabled false \
  --type stdio \
  --command "nix" \
  --args "run" \
  --args "nixpkgs#gitea-mcp-server" \
  --args "--" \
  --args "-r" \
  --args "-O" \
  --args "list_my_repos,list_org_repos,search_repos,get_file_contents,get_dir_contents,get_repository_tree,list_commits,get_commit,list_branches,list_issues,issue_read,list_pull_requests,pull_request_read,search_issues,get_me"

# HA-MCP Custom Component running the full ha-mcp server in-process inside
# Home Assistant. Uses HASS_MCP_URL.
# Prompt-cost trim: the server pins 11 tools (~9.2k prompt tokens on every
# request). The four dropped ones (ha_config_set_automation, ha_manage_backup,
# ha_get_overview, ha_report_issue) are ~5.9k tokens of schema and are rarely
# needed. They stay reachable through ha_search_tools plus
# ha_call_read/write/delete_tool, which execute by name server-side, so
# nothing is lost, only the always-loaded schema text. Names here are bare
# tool names, not mcp_ha_*; a name that does not exist unregisters the server.
mcp add ha \
  --disabled false \
  --type http \
  --url "${HASS_MCP_URL}" \
  --timeout 30 \
  --enabled-tools ha_search \
  --enabled-tools ha_search_tools \
  --enabled-tools ha_get_skill_guide \
  --enabled-tools ha_config_get_automation \
  --enabled-tools ha_call_read_tool \
  --enabled-tools ha_call_write_tool \
  --enabled-tools ha_call_delete_tool

# Uses SIGNAL_MCP_ACCOUNT, SIGNAL_MCP_OPERATOR, SIGNAL_MCP_TRUSTED_SENDERS
# Have to do a "bash -c" workaround because a bug in crush duplicates all args,
# breaking the command line.
mcp add signal \
  --disabled false \
  --type stdio \
  --command "bash" \
  --args "-c" \
  --args 'nix shell nixpkgs#uv nixpkgs#python3 --command uvx -q --from git+https://github.com/joestump/signal-mcp signal-mcp --transport stdio --channel' \
  --env UV_PYTHON_DOWNLOADS "never" \
  --env UV_PYTHON_PREFERENCE "system"

# Uses SEARXNG_URL (falls back to the LAN instance)
# The mcp<2 pin is needed: mcp-searxng is not compatible with the 2.x SDK.
# Same "bash -c" workaround as the signal server for the duplicated-args bug.
mcp add searxng \
  --disabled false \
  --type stdio \
  --command "bash" \
  --args "-c" \
  --args 'uvx -q --from mcp-searxng --with "mcp<2" mcp-searxng' \
  --env SEARXNG_URL "http://searxng.home.arpa" \
  --env UV_PYTHON_DOWNLOADS "never" \
  --env UV_PYTHON_PREFERENCE "system"

# TODO: in YOLO mode we shouldn't need these, right?
permissions allow mcp_signal_send_message_to_user mcp_nix_nix
permissions allow mcp_tavily_tavily_search mcp_tavily_tavily_extract

# A Signal session is a chat, not a coding workspace. `question` renders a
# terminal form the phone can never see, so it is pure dead weight (~1.6k
# prompt tokens on every request).
permissions deny question

# Optional further trims, ~1k prompt tokens each line. Uncomment as needed.
# Scheduling, dispatched coding subagents, and language-server tools are
# rarely used from a chat session.
# permissions deny CronCreate CronDelete CronList
# permissions deny dispatch_agent apply_dispatch dismiss_dispatch cancel_dispatch message_agent
# permissions deny lsp_call_hierarchy lsp_definition lsp_diagnostics lsp_references lsp_rename lsp_replace_symbol lsp_restart lsp_symbols

