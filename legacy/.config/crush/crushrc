option metrics false

provider add crush --disable true
provider add exa --disable true

provider add local-ollama \
  --type openai-compat \
  --base-url "http://ollama.home.arpa:11434/v1" \
  --api-key "ollama"

# Bump timeout for longer prefill times (30k+ tokens).
option request-timeout 0

provider add mercury-halogen \
  --type openai \
  --base-url "http://mercury:8731/v1" \
  --api-key "halogen"

model add local-ollama/gemma-large-1gpu \
  --name "gemma-large-1gpu" \
  --context-window 48000 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

model add local-ollama/qwen-small-1gpu \
  --name "qwen-small-1gpu" \
  --context-window 128000 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

model add local-ollama/qwen-large-1gpu \
  --name "qwen-large-1gpu" \
  --context-window 128000 \
  --default-max-tokens 8192 \
  --can-reason true \
  --supports-images true

# Cost of 1h = 0.33 SFr * 0.15 kW = ~0.05 SFr
# input  1500 t/s, 5.4M t/h: 9.2e-9
# output 45 t/s,   162k t/h: 3e-7
model add mercury-halogen/qwen3.8-flash-next \
  --name "qwen-large-mercury-halogen" \
  --context-window 100000 \
  --default-max-tokens 65536 \
  --can-reason true \
  --reasoning-effort medium \
  --price-input 0.00000001 \
  --price-output 0.0000003 \
  --supports-images true

model small local-ollama/qwen-small-1gpu
#model large local-ollama/qwen-large-1gpu --think
model large mercury-halogen/qwen3.8-flash-next --think

mcp add nix \
  --disabled false \
  --type stdio \
  --command "nix" \
  --args "run" \
  --args "github:utensils/mcp-nixos" \
  --args "--"

# Uses GITEA_HOST, GITEA_ACCESS_TOKEN
mcp add gitea \
  --disabled true \
  --type stdio \
  --command "nix" \
  --args "run" \
  --args "nixpkgs#gitea-mcp-server" \
  --args "--"

# Home Assistant's own MCP server. Streamable HTTP replaces the old SSE
# endpoint (/mcp_server/sse), which the integration no longer serves.
# Uses HOMEASSISTANT_URL, HOMEASSISTANT_TOKEN
mcp add ha \
  --disabled false \
  --type http \
  --url "${HASS_SERVER}/api/mcp" \
  --header Authorization "Bearer ${HASS_TOKEN}" \
  --timeout 30

# Uses SIGNAL_MCP_ACCOUNT, SIGNAL_MCP_OPERATOR, SIGNAL_MCP_TRUSTED_SENDERS
# Have to do a "bash -c" workaround because a bug in crush duplicates all args,
# breaking the command line.
mcp add signal \
  --disabled false \
  --type stdio \
  --command "bash" \
  --args "-c" \
  --args 'nix shell nixpkgs#uv nixpkgs#python3 --command uvx -q --from git+https://github.com/joestump/signal-mcp signal-mcp --transport stdio --channel' \
  --env UV_PYTHON_DOWNLOADS "never" \
  --env UV_PYTHON_PREFERENCE "system"

# Uses SEARXNG_URL (falls back to the LAN instance)
# The mcp<2 pin is needed: mcp-searxng is not compatible with the 2.x SDK.
# Same "bash -c" workaround as the signal server for the duplicated-args bug.
mcp add searxng \
  --disabled false \
  --type stdio \
  --command "bash" \
  --args "-c" \
  --args 'uvx -q --from mcp-searxng --with "mcp<2" mcp-searxng' \
  --env SEARXNG_URL "${SEARXNG_URL:-http://searxng.home.arpa}" \
  --env UV_PYTHON_DOWNLOADS "never" \
  --env UV_PYTHON_PREFERENCE "system"

# TODO: in YOLO mode we shouldn't need these, right?
permissions allow mcp_signal_send_message_to_user mcp_nix_nix

