{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://ollama.home.arpa:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "gemma4:26b": {
          "limit": {
            "context": 48000,
            "output": 8192
          },
          "tools": true
        }
      }
    }
  },
  "model": "local-ollama/gemma4:26b",
  "compaction": {
    "auto": true,
    "prune": true,
    "threshold": 0.75,
    "preserve_recent_tokens": 16384,
    "reserved": 8192
  },
  "tool_output": {
    "max_bytes": 16384,
    "max_lines": 200
  },
  "mcp": {
    "nix": {
      "type": "local",
      "command": [
        "nix",
        "run",
        "github:utensils/mcp-nixos",
        "--"
      ],
      "enabled": true
    },
    "gitea": {
      "type": "local",
      "command": [
        "nix",
        "run",
        "nixpkgs#gitea-mcp-server",
        "--"
      ],
      "enabled": true
    },
    "ha": {
      "type": "local",
      "command": [
        "nix",
        "shell",
        "nixpkgs#uv",
        "nixpkgs#python3",
        "--command",
        "uv",
        "tool",
        "run",
        "ha-mcp"
      ],
      "environment": {
        "UV_PYTHON_DOWNLOADS": "never",
        "UV_PYTHON_PREFERENCE": "system"
      },
      "enabled": true
    }
  }
}
